# Generated by XcodeGen (decision 0005) — the spec in project.yml is the source of truth
UbuntuPad.xcodeproj/
track-b-runtime/ios/UbuntuPad/Info.plist
track-b-runtime/ios/UbuntuPad/UbuntuPad.entitlements

# The cross-compiled arm64 Linux guest programs CI drops into the app bundle (decision 0020). They are
# build output: `tools/build-guest-binaries.sh` produces them and `build-ipa.yml` fetches the artifact.
track-b-runtime/ios/Guest/hello-pie-nostdlib
track-b-runtime/ios/Guest/stack-probe-nostdlib

